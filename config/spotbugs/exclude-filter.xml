<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

  <!--
      Spring injecte volontairement des références dans les services.
      Ces avertissements n'apportent aucune valeur ici.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <!--
      Les DTO Java records retournent volontairement leurs collections.
      Les copier systématiquement alourdirait inutilement le code.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>

</FindBugsFilter>

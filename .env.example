# Copy this file to .env for local development.
# Never commit the real .env file because it contains credentials and secrets.

# PostgreSQL JDBC connection string used by Spring Boot.
DB_URL=jdbc:postgresql://localhost:5432/valorant_tracker

# PostgreSQL application user.
DB_USERNAME=valorant

# PostgreSQL password. Replace this value locally.
DB_PASSWORD=change-me

# Base URL of the Henrik API.
HENRIK_API_BASE_URL=https://api.henrikdev.xyz

# Henrik API key used by the backend. Keep this value private.
HENRIK_API_KEY=

# Static secret required in the X-Admin-Key header for administrative routes.
ADMIN_API_KEY=replace-with-a-long-random-secret

# Angular development server allowed by the CORS configuration.
FRONTEND_ORIGIN=http://localhost:4200

# Delay between standard synchronization executions, expressed as ISO-8601 duration.
STANDARD_SYNC_DELAY=PT4H

# Delay between deep synchronization worker executions, expressed as ISO-8601 duration.
DEEP_SYNC_DELAY=PT10M

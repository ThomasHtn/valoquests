# =============================================================================
# PostgreSQL
# =============================================================================

# PostgreSQL connection used by the application.
DB_URL=jdbc:postgresql://localhost:5432/valorant_tracker

# Database credentials.
DB_USERNAME=valorant
DB_PASSWORD=change-me


# =============================================================================
# Henrik API
# =============================================================================

# HenrikDev API base URL.
HENRIK_API_BASE_URL=https://api.henrikdev.xyz

# HenrikDev API key.
HENRIK_API_KEY=

# Region and platform shared by all tracked players.
HENRIK_API_REGION=eu
HENRIK_API_PLATFORM=pc

# Maximum number of retry attempts for temporary Henrik API failures.
# A value of 2 means:
# - first request
# - one retry if the request fails with a retryable error
HENRIK_API_MAX_ATTEMPTS=2

# Minimum delay before retrying a failed Henrik request.
# If Henrik returns a Retry-After header, the greater value is used.
HENRIK_API_RETRY_DELAY=PT60S

# Maximum number of requests allowed per minute for the current API key.
# The request limiter spreads requests evenly over time.
# Standard free keys are limited to 30 requests/minute.
HENRIK_API_REQUESTS_PER_MINUTE=5

# Additional safety margin added between two consecutive requests.
HENRIK_API_RATE_LIMIT_SAFETY_MARGIN=PT0.5S


# =============================================================================
# Application
# =============================================================================

# Secret required to access administrative endpoints.
ADMIN_API_KEY=replace-with-a-long-random-secret

# Angular development server allowed by CORS.
FRONTEND_ORIGIN=http://localhost:4200

# Delay between standard synchronization executions.
STANDARD_SYNC_DELAY=PT4H

# Delay between deep synchronization executions.
DEEP_SYNC_DELAY=PT10M

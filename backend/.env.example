# =============================================================================
# PostgreSQL
# =============================================================================

# PostgreSQL connection used by the application.
DB_URL=jdbc:postgresql://localhost:5432/valo_quests

# Database credentials.
DB_USERNAME=valorant
DB_PASSWORD=change-me


# =============================================================================
# Henrik API
# =============================================================================

# HenrikDev API base URL.
HENRIK_API_BASE_URL=https://api.henrikdev.xyz

# HenrikDev API key.
HENRIK_API_KEY=

# Region and platform shared by all tracked players.
HENRIK_API_REGION=eu
HENRIK_API_PLATFORM=pc

# HTTP connection and response timeouts.
HENRIK_API_CONNECT_TIMEOUT=PT5S
HENRIK_API_READ_TIMEOUT=PT20S

# Maximum number of attempts for a genuine transient Henrik failure (timeout, 5xx).
# This value includes the initial request.
HENRIK_API_MAX_ATTEMPTS=4

# Delay before retrying a transient Henrik API failure.
# The Retry-After response header takes precedence when appropriate.
HENRIK_API_RETRY_DELAY=PT60S

# Maximum number of attempts when Henrik responds with a rate limit (HTTP 429).
# Rate limiting is expected during a long match-history walk, so it gets a much larger budget than
# HENRIK_API_MAX_ATTEMPTS. This value includes the initial request.
HENRIK_API_RATE_LIMIT_MAX_ATTEMPTS=25

# Maximum number of requests allowed per minute for the current API key.
# The application uses a small safety margin below the provider limit.
HENRIK_API_REQUESTS_PER_MINUTE=28

# Additional safety duration between two consecutive API requests.
HENRIK_API_RATE_LIMIT_SAFETY_MARGIN=PT0.1S


# =============================================================================
# Application
# =============================================================================

# Secret required to access administrative endpoints.
ADMIN_API_KEY=replace-with-a-long-random-secret

# Failed X-Admin-Key attempts allowed per remote address before a temporary lockout.
ADMIN_RATE_LIMIT_MAX_FAILURES=5

# Duration a remote address stays locked out after exceeding the failure budget above.
ADMIN_RATE_LIMIT_LOCKOUT_DURATION=PT1M

# Angular development server allowed by CORS.
FRONTEND_ORIGIN=http://localhost:4200

# Serves the OpenAPI document and Swagger UI at /api-docs and /swagger-ui.html. On here because
# that is what local development wants; leave it off (or unset) anywhere reachable, since the
# document maps out every administrative route, its payload and its error codes.
API_DOCS_ENABLED=true

# How X-Forwarded-* headers are handled. Keep `framework` when a reverse proxy (Traefik) terminates
# TLS in front of the application: the lockout above is keyed on the caller's address, and without
# this every caller looks like the proxy, so one attacker's failures lock out the operator too.
# Set to `none` only if the application is ever exposed directly, where a caller could forge the
# header itself.
FORWARD_HEADERS_STRATEGY=framework


# =============================================================================
# Scheduling
# =============================================================================

# Enables automatic synchronization of all active players.
STANDARD_SYNC_ENABLED=true

# Runs on the hour and on the half hour, which is also what keeps the campaign's base current.
STANDARD_SYNC_CRON=0 0/30 * * * *

# Time zone used by the standard synchronization scheduler.
SCHEDULING_ZONE=Europe/Paris

# Enables automatic finalization of the previous week.
WEEK_ROLLOVER_ENABLED=true

# Runs every Monday at 02:05, in the zone below. Late enough for the matches started on Sunday
# evening to have ended and been imported: a week frozen at 00:05 lost them.
WEEK_ROLLOVER_CRON=0 5 2 * * MON

# Time zone used by weekly calculations (week boundaries, active days, challenge draws) and by the
# rollover cron above. Both must stay on this single value.
WEEK_ROLLOVER_ZONE=Europe/Paris

# Enables the daily campaign tick: daily challenge draw, campaign start on its first Monday, replay.
# A finished campaign is closed by the weekly rollover, not by the tick.
CAMPAIGN_TICK_ENABLED=true

# Runs every day at 00:10, in the WEEK_ROLLOVER_ZONE above. The replay is idempotent, so an extra
# firing is harmless.
CAMPAIGN_TICK_CRON=0 10 0 * * *

# =============================================================================
# Local development settings: `cp .env.example .env` and the backend starts as is.
# Values are read as a .properties file, so never quote them. Demo administrator key below: never deploy it.
# =============================================================================

# =============================================================================
# PostgreSQL
# =============================================================================
# PostgreSQL of compose.yaml (`make db`), published on 5433 so it never clashes with a native install.
# Native PostgreSQL instead: jdbc:postgresql://localhost:5432/valo_quests and your role's password.
DB_URL=jdbc:postgresql://localhost:5433/valo_quests
DB_USERNAME=valorant
DB_PASSWORD=valorant

# =============================================================================
# Henrik API
# =============================================================================
HENRIK_API_BASE_URL=https://api.henrikdev.xyz
# Personal key from https://docs.henrikdev.xyz. The placeholder lets the app start; no match is imported with it.
HENRIK_API_KEY=replace-with-your-henrikdev-key
# Region and platform shared by all tracked players.
HENRIK_API_REGION=eu
HENRIK_API_PLATFORM=pc
HENRIK_API_CONNECT_TIMEOUT=PT5S
HENRIK_API_READ_TIMEOUT=PT20S
# Attempts for a transient failure (timeout, 5xx), first request included.
HENRIK_API_MAX_ATTEMPTS=4
# Delay before a retry; a longer Retry-After header wins.
HENRIK_API_RETRY_DELAY=PT60S
# Attempts on HTTP 429: throttling is expected on a long walk, so it gets a far larger budget.
HENRIK_API_RATE_LIMIT_MAX_ATTEMPTS=25
# Requests per minute allowed by your key, minus a small margin, plus a gap between two requests.
HENRIK_API_REQUESTS_PER_MINUTE=28
HENRIK_API_RATE_LIMIT_SAFETY_MARGIN=PT0.1S

# =============================================================================
# Application
# =============================================================================
# Secret of the admin routes, sent as X-Admin-Key. At least 32 characters; `make key` makes one.
ADMIN_API_KEY=valoquests-demo-admin-key-0123456789
# Failed admin attempts per remote address before a lockout, and its duration.
ADMIN_RATE_LIMIT_MAX_FAILURES=5
ADMIN_RATE_LIMIT_LOCKOUT_DURATION=PT1M
# Swagger UI and OpenAPI document; keep it off on any reachable deployment.
API_DOCS_ENABLED=true
# Keep `native` behind a proxy: `framework` trusts a client-sent `Forwarded` header and defeats the lockout.
FORWARD_HEADERS_STRATEGY=native
# How long a synchronization that imported nothing stays in the history.
SYNC_QUIET_HISTORY_RETENTION=P7D

# =============================================================================
# Calendar
# =============================================================================
# Zone of every day and week boundary and of every job below.
CALENDAR_ZONE=Europe/Paris

# =============================================================================
# Scheduling
# =============================================================================
# Every five minutes: imports the squad's finished matches and keeps the base current.
STANDARD_SYNC_ENABLED=true
STANDARD_SYNC_CRON=0 */5 * * * *
# Monday 02:05: late enough for Sunday evening games to have ended.
WEEK_ROLLOVER_ENABLED=true
WEEK_ROLLOVER_CRON=0 5 2 * * MON
# Daily 00:10: daily challenge draw and campaign replay.
CAMPAIGN_TICK_ENABLED=true
CAMPAIGN_TICK_CRON=0 10 0 * * *
# Daily 03:30: deletes the quiet synchronizations past their retention.
SYNC_HISTORY_PURGE_ENABLED=true
SYNC_HISTORY_PURGE_CRON=0 30 3 * * *

<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Spring Boot defaults provide consistent timestamps and level formatting. -->
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

  <!-- Keep framework noise at INFO while allowing targeted package overrides. -->
  <logger name="io.github.thomashtn.valoquests" level="INFO"/>
  <logger name="io.github.thomashtn.valoquests.match.service.MatchImportService" level="INFO"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>

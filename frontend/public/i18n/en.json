        "title": "One boss, one shared health bar"
      },
      "challenges": {
        "description": "Every Monday, five challenges get pulled out of a hat of 46, one for each difficulty tier. No checkbox to tick, no form to fill in: the moment your matches sync, your progress ticks up on its own.",
        "eyebrow": "Step 1 · Weekly challenges",
        "title": "Five challenges, one per difficulty"
      },
      "damage": {
        "bonuses": "Bonus points for showing up: playing on several days in the week and teaming up with others on the same challenge both pile extra damage on the stack.",
        "description": "Ranked win? Big hit. Casual match, even a loss? Still chips in. Finish a challenge and cash in a fat damage bonus on top, bigger the harder it was.",

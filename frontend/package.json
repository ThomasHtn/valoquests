{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint && npm run lint:styles",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\"",
    "format": "prettier --write . ../README.md ../backend/README.md \"../docs/*.md\" \"../.github/**/*.yml\"",
    "format:check": "prettier --check . ../README.md ../backend/README.md \"../docs/*.md\" \"../.github/**/*.yml\""
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@lucide/angular": "^1.55.0",
    "chart.js": "^4.5.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "22.5.0",
    "eslint": "^10.6.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.23",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "^4.0.8"
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <!-- Maven model version used by this project descriptor. -->
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot manages compatible dependency and plugin versions. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.6</version>
    <relativePath/>
  </parent>

  <!-- Project coordinates. -->
  <groupId>io.github.thomashtn</groupId>
  <artifactId>valorant-tracker</artifactId>
  <version>0.0.1-SNAPSHOT</version>

  <name>Valorant Tracker</name>

  <description>
    Backend for collecting and exposing Valorant player statistics,
    challenges and rankings.
  </description>

  <properties>
    <!-- Java language level required to compile and run the application. -->
    <java.version>25</java.version>

    <!-- Explicit versions for dependencies not managed by Spring Boot. -->
    <mapstruct.version>1.6.3</mapstruct.version>
    <springdoc.version>3.0.3</springdoc.version>
    <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    <mockwebserver.version>4.12.0</mockwebserver.version>

    <!-- Version shared by all Testcontainers dependencies. -->
    <testcontainers.version>2.0.5</testcontainers.version>
  </properties>

  <dependencies>

    <!--
        Spring MVC, embedded servlet container and JSON serialization.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
        Reactive WebClient used to communicate with the Henrik API.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webclient</artifactId>
    </dependency>

    <!--
        Database persistence with Spring Data JPA and Hibernate.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!--
        Jakarta Bean Validation support for configuration properties,
        DTOs and HTTP requests.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
        Spring Security infrastructure used to protect administrator routes.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!--
        Health, information and metrics endpoints.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
        Generates the OpenAPI document and exposes Swagger UI.
    -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!--
        Generates metadata for typed Spring configuration properties.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
        Flyway integration managed by Spring Boot.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>

    <!--
        PostgreSQL-specific Flyway support.
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!--
        PostgreSQL JDBC driver required when running the application.
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
        Compile-time DTO and entity mapper generation.
    -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>

    <!--
        Compile-time boilerplate generation.
    -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- ============================================================= -->
    <!-- Test dependencies                                             -->
    <!-- ============================================================= -->

    <!--
        Main Spring Boot test stack:
        JUnit Jupiter, AssertJ, Mockito and Spring Test.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
        Spring MVC test support, including MockMvc.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
        Spring Security test helpers.
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
        In-memory database used by automated tests.
    -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
    JUnit 5 integration used to manage the lifecycle of Testcontainers.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>

    <!--
        PostgreSQL container used by integration tests.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver</artifactId>
      <version>${mockwebserver.version}</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>

      <!--
          Configures Java compilation and annotation processors.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>

        <configuration>
          <!--
              Keeps method parameter names available to Spring
              and OpenAPI at runtime.
          -->
          <parameters>true</parameters>

          <annotationProcessorPaths>

            <!-- Lombok annotation processor. -->
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>

            <!-- MapStruct annotation processor. -->
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>

            <!--
                Allows Lombok-generated members to be correctly
                detected by MapStruct.
            -->
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok-mapstruct-binding</artifactId>
              <version>${lombok-mapstruct-binding.version}</version>
            </path>

            <!--
                Generates configuration metadata for application
                properties.
            -->
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <version>${project.parent.version}</version>
            </path>

          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!--
          Packages the application as an executable Spring Boot archive.
      -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>

        <configuration>
          <!--
              Lombok is only required during compilation and must not
              be bundled inside the final application archive.
          -->
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

    </plugins>
  </build>

</project>
